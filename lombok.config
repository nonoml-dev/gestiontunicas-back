# Configuración de Lombok para todo el proyecto
config.stopBubbling = true

# Marca el código generado con @lombok.Generated para que la cobertura de tests lo ignore
lombok.addLombokGeneratedAnnotation = true

# @Data no se usa en las entidades JPA: su equals/hashCode/toString recorre las relaciones perezosas.
# En las entidades, usar @Getter y @Setter.
lombok.data.flagUsage = warning
